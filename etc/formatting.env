# ANSI CODES - STYLES, COLORS, MESSAGES
# ================================================
# source this .env file to setup easy-to-use ANSI code formatting
# optionally, use ./formatting.sh
#
# reference: https://en.wikipedia.org/wiki/ANSI_escape_code

# FORMATS
# ------------------------------------------------
FMT_BOLD="\e[1m"
FMT_BOLD_="\e[22m" # NOT bold
FMT_DIM="\e[2m"
FMT_DIM_="\e[22m" # normal intensity - NOT bold, dim
FMT_ITALIC="\e[3m"
FMT_ITALIC_="\e[23m" # NOT italics, not blackletter
FMT_UNDER="\e[4m"
FMT_UNDER_="\e[24m" # NOT underlined
FMT_BLINK="\e[5m"
FMT_BLINK_="\e[25m" # NOT blinking
FMT_BLINK_FAST="\e[6m"
FMT_REVERSE="\e[7m"   # swap FG/BG -  good for legibility
FMT_REVERSE_="\e[27m" # NOT inverted/reversed
FMT_CONCEAL="\e[8m"
FMT_CONCEAL_="\e[28m" # NOT concealed
FMT_STRIKE="\e[9m"
FMT_STRIKE_="\e[29m" # NOT strikethrough
# 10 = default, 11-19 alternative font?! FMT_NOT SUPPORTED
# 50+ are not widely implenented across terminals
FMT_FRAMED="\e[51m"
FMT_CIRCLED="\e[52m"
FMT_OVERLINE="\e[53m"
FMT_FRAMED_="\e[54m"   # NOT framed, circled
FMT_CIRCLED_="\e[54m"  # NOT framed, circled
FMT_OVERLINE_="\e[55m" # NOT overlined
FMT_CLR="\e[0m"        # reset all formatting to defaults

# COLORS
# ------------------------------------------------
FG_BLACK="\e[30m"
FG_RED="\e[31m"
FG_GREEN="\e[32m"
FG_YELLOW="\e[33m"
FG_BLUE="\e[34m"
FG_MAGENTA="\e[35m"
FG_CYAN="\e[36m"
FG_WHITE="\e[37m"
FG_RGB="\e[38;5;"      # ...<0-255>m
FG_FULL_RGB="\e[38;2;" # ...<0-128>r;<0-128>g;<0-128>bm
FG_DEFAULT="\e[39m"    # default foreground
BG_BLACK="\e[40m"
BG_RED="\e[41m"
BG_GREEN="\e[42m"
BG_YELLOW="\e[43m"
BG_BLUE="\e[44m"
BG_MAGENTA="\e[45m"
BG_CYAN="\e[46m"
BG_WHITE="\e[47m"
BG_RGB="\e[48;5;"      # ...<0-255>m
BG_FULL_RGB="\e[48;2;" # ...<0-128>r;<0-128>g;<0-128>bm
BG_DEFAULT="\e[49m"    # default background

# MESSAGE FORMATTING
# ================================================
#
# LINUX SYSLOG LEVELS
# Level	Name       Description
# 0	    EMERG	   System is unusable.
# 1	    ALERT	   Immediate action is required.
# 2	    CRIT	   Critical conditions that may cause system failure.
# 3	    ERR	       Error conditions that require attention.
# 4	    WARNING	   Warning conditions that may lead to problems.
# 5	    NOTICE	   Normal but significant events.
# 6	    INFO	   General information about system events.
# 7	    DEBUG	   Detailed information for debugging purposes.

# FORMATS
# ------------------------------------------------
# 0
FMT_EMERG="${FMT_BOLD}${FG_RED}${FMT_REVERSE}"
# 1 
FMT_ALERT="${FG_RED}${FMT_UNDER}"
# 2
FMT_CRITICAL="${FMT_BOLD}${FG_RED}"
# 3
FMT_ERROR="${FG_RED}"
# 4
FMT_WARN="${FG_MAGENTA}"
# 5
FMT_SUCCESS="${FG_GREEN}"
FMT_FAILURE="${FG_RED}"
FMT_ACTION="${FG_YELLOW}"
FMT_BANNER="${FMT_BOLD}${FG_BLUE}${FMT_REVERSE}"
# 6
FMT_INFO="${FG_BLUE}"
FMT_WRITE=""
FMT_DIVIDER=""
# 7 
FMT_DEBUG="${FG_CYAN}"
FMT_DRYRUN="${FG_YELLOW}${FMT_ITALIC}"
# 8
FMT_TRACE=""
# OTHER
FMT_EXAMPLE="${FMT_BOLD}${FG_BLUE}"
FMT_H1="${FG_BOLD}${FG_BLUE}"
FMT_H2="${FG_BOLD}"
FMT_ARG="${FG_GREEN}"

# MESSAGES, FORMAT: "<9 CHARS>: "
# ------------------------------------------------
# 0
MSG_EMERG="${FMT_EMERG}EMERGENCY${FMT_CLR}: "
# 1
MSG_ALERT="${FMT_ALERT}ALERT${FMT_CLR}    : "
# 2
MSG_CRITICAL="${FMT_CRITICAL}CRITICAL${FMT_CLR} : "
# 3
MSG_ERROR="${FMT_ERROR}ERROR${FMT_CLR}    : "
# 4 
MSG_WARN="${FMT_WARN}WARN${FMT_CLR}     : "
# 5
MSG_SUCCESS="${FMT_SUCCESS}SUCCESS${FMT_CLR}  : "
MSG_FAILURE="${FMT_FAILURE}FAILURE${FMT_CLR}  : "
MSG_ACTION="${FMT_ACTION}ACTION${FMT_CLR}   : "
MSG_BANNER="${FMT_BANNER}"
# 6
MSG_INFO="${FMT_INFO}INFO${FMT_CLR}     : "
MSG_WRITE="${FMT_WRITE}         : "
# do NOT add $FMT_CLR to MSG_PRINT - breaks e.g. msg_divider within msg_banner
MSG_PRINT=""
MSG_DIVIDER="${FMT_DIVIDER}"
# 6
MSG_DEBUG="${FMT_DEBUG}DEBUG${FMT_CLR}    : "
MSG_DRYRUN="${FMT_DRYRUN}DRYRUN${FMT_CLR}   : "
# 7
MSG_TRACE="${FMT_TRACE}TRACE${FMT_CLR}    : "
